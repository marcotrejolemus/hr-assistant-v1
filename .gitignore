# Lo que nunca se sube al repositorio del producto.
# Se alinea con scripts/release_manifest.py: lo ignorado aquí es lo mismo que el
# manifiesto de publicación omite o bloquea, para que el índice de git coincida.

# Archivos de entorno con secretos; solo las plantillas públicas se versionan
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Entornos virtuales
.venv/
venv/

# Cachés de Python y de herramientas
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/

# Cobertura
.coverage

# Resultados de Playwright
test-results/
playwright-report/
.playwright/

# Editores y sistema operativo
.idea/
.DS_Store

# Llaves, certificados y credenciales
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
*.ppk
*.asc
*.gpg
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
.netrc
.pgpass
.pypirc
.npmrc
.htpasswd
credentials
credentials.*
*credentials.json
*credentials.yaml
*credentials.yml
service-account*.json
secrets.json
secrets.yaml
secrets.yml
secrets.toml
secrets.ini
secrets.txt
