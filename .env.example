# Variables del HR Assistant. Copia este archivo a .env y llena solo lo que uses.
# Nunca subas valores reales: los secretos van vacios aqui.

# Proveedor del modelo: fake (simulado, sin red) o gateway (Cloudflare AI Gateway)
MODEL_PROVIDER=fake
ENVIRONMENT=development
EMPLOYEES_PATH=data/employees.json

# Acceso por cliente (spec/04). API_KEYS es secreta: cliente:clave,cliente2:clave2
# Vacia, todas las peticiones a /ask y /metrics reciben 401.
# En produccion cada clave debe tener 16 caracteres o mas.
API_KEYS=
RATE_LIMIT_PER_MINUTE=30

# Cloudflare (obligatorias con MODEL_PROVIDER=gateway; CF_API_TOKEN es secreto)
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
CF_API_TOKEN=

# Modelos y palancas de costo (spec/03)
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
# Cache del gateway: 0 la apaga; en produccion debe ser 0 (ADR 0006)
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json

# Limites del Supervisor
AGENT_MAX_STEPS=3
REVIEWER_MAX_CALLS=1
MAX_MODEL_CALLS_PER_REQUEST=4
REQUEST_INPUT_TOKEN_BUDGET=4000
MODEL_TIMEOUT_SECONDS=15
REQUEST_TIMEOUT_SECONDS=30
MAX_QUESTION_CHARS=2000
MAX_HISTORY_MESSAGES=50
MAX_ANSWER_CHARS=4000

# Observabilidad (LANGSMITH_API_KEY es secreta)
SERVICE_NAME=hr-assistant
SLO_P95_MS=2000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hr-assistant-v1
HIDE_INPUTS=true
HIDE_OUTPUTS=true

# Solo para pruebas con MODEL_PROVIDER=fake; no las definas en produccion.
# FAKE_MODEL_FAIL=false
# FAKE_REVIEWER_VERDICT=approve
# FAKE_REVIEWER_FAIL=false
